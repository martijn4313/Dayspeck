// MotoWeather secrets - copy this file to secrets.h (which is git-ignored) and fill it in.
// Never commit secrets.h.

// Compile-time WiFi credentials (optional: they can also be set from the web UI)
#define WIFI_SSID "your-network"
#define WIFI_PASS "your-password"

// Google Geolocation API key (optional, enables automatic location from nearby WiFi access points).
// Privacy: the BSSID and signal strength of nearby access points are sent to Google.
